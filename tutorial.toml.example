[tts]
provider = "qwen3"
model = "Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice"
voice = "Ryan"
language = "English"
device = "auto"
rate = 1.15

# Alternative: narrate in a cloned personal voice instead of a preset
# speaker. Requires a Base checkpoint and has no `voice` field.
#
# [tts]
# provider = "qwen3-clone"
# model = "Qwen/Qwen3-TTS-12Hz-0.6B-Base"
# ref_audio = "~/voices/narrator.wav"
# ref_text = "Exact transcript of the reference recording."
# language = "English"
# device = "auto"
# rate = 1.15

[captions]
enabled = true
burn = true
font_size = 42

[render]
width = 1920
height = 1080
fps = 60

[output]
directory = "./output"
